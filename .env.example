# Application
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://decentrawill:decentrawill_secure_pass@localhost:5432/decentrawill?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=decentrawill-vault

# JWT Secrets
JWT_ACCESS_SECRET=decentrawill_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=decentrawill_jwt_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STEP_UP_TOKEN_EXPIRES_IN=10m

# Master Encryption Key (32 bytes hex for AES-256-GCM envelope encryption)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Blockchain (Ethereum Sepolia / Local Anvil/Hardhat)
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_CHAIN_ID=11155111
# Dedicated platform relayer / proof anchor signer key
BLOCKCHAIN_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Smart Contracts Addresses (deployed addresses or mock)
CONTRACT_WILL_REGISTRY=0x1111111111111111111111111111111111111111
CONTRACT_INTEGRITY_ANCHOR=0x2222222222222222222222222222222222222222
CONTRACT_ATTESTATION_REGISTRY=0x3333333333333333333333333333333333333333
CONTRACT_ASSET_REGISTRY=0x4444444444444444444444444444444444444444
CONTRACT_GOVERNANCE_REGISTRY=0x5555555555555555555555555555555555555555
CONTRACT_ASSET_TRANSFER_MANAGER=0x6666666666666666666666666666666666666666

# Providers
